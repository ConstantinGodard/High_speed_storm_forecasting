#!/bin/bash
#SBATCH --job-name=CLSTM_load
#SBATCH --output=out_loading_model.txt
#SBATCH --error=out_loading_model.txt
#SBATCH --partition=gpua100
#SBATCH --gres=gpu:1
#SBATCH --time=24:00:00
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=4

# Initialise conda pour ce job
source /gpfs/softs/languages/anaconda3/2024.06/etc/profile.d/conda.sh
conda activate torch_env

module purge
module load cuda/11.8.0/gcc-11.2.0

# Lance le script Python
python -u loading_model.py
